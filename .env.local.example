# Copy this file to `.env.local` and fill in real values.
# NEVER put real secrets in this example file.

# Google Apps Script web app endpoint (server-side only)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec

# Admin authentication (server-side only — never use NEXT_PUBLIC_ for these)
# Note: if a value contains "#", wrap it in double quotes (e.g. PASSWORD="a#b").
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-hex-string

# Optional: canonical site URL used for SEO metadata
# NEXT_PUBLIC_SITE_URL=https://example.com
