# Copy this file to `.env.local` and fill in real values.
# NEVER put real secrets in this example file.

# Google Apps Script web app endpoint (server-side only)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec

# Secret used to sign admin session cookies (server-side only)
# Generate a long random value, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=PASTE_A_LONG_RANDOM_SECRET



# Optional: canonical site URL used for SEO metadata
# NEXT_PUBLIC_SITE_URL=https://example.com
